<ui>
  <!-- Demo UIDocument -- Unity UI Toolkit-style declarative UI. Spawned onto the Bottom screen
       at Play start by UIDocumentDemoBehaviour (see the "UIMenuController" entity). Edit this
       file in a text editor, then use the .uidoc asset's "Reload" button in Properties (Content
       Browser -> click DemoMenu.uidoc) to see changes without restarting the Editor. -->
  <style>
    .panel { background-color: #202836; }
    .title-bar { background-color: #16202c; }
    .primary-button {
      normal-color: #3a6fa8;
      hover-color: #5aa9ff;
      pressed-color: #2a4f78;
    }
  </style>

  <Panel class="panel" screen="Bottom" anchor="middle-center" width="220" height="140">
    <Panel class="title-bar" anchor="top-center" y="0" width="220" height="28"/>
    <Button id="playButton" class="primary-button" behaviour="UIButtonClickBehaviour"
            anchor="middle-center" y="10" width="120" height="32"/>
    <Button id="quitButton" behaviour="UIButtonClickBehaviour"
            anchor="bottom-center" y="10" width="120" height="32"
            normal-color="#8a3a3a" hover-color="#c85a5a" pressed-color="#6a2a2a"/>
  </Panel>
</ui>
