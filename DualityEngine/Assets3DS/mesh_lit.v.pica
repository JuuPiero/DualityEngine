; DualityEngine vertex shader for Lit/* and Toon/* materials (PICA200 fragment lighting).
; The lighting itself runs in the fixed-function fragment lighting unit (up to 8 lights,
; LUT-driven specular / toon ramp / spot / distance attenuation, optional bump mapping), which
; needs two extra varyings per vertex:
;   view       -- vector from the vertex to the eye, in view space
;   normalquat -- the tangent frame (T, B, N) as a unit quaternion, in view space
; Quaternion construction follows devkitPro's examples/3ds/graphics/gpu/normal_mapping vshader
; (case discrimination on the largest diagonal term for numerical stability).

; Uniforms
.fvec projection[4], modelView[4], normalMatrix[3], uvTransform

; Constants
.constf myconst(0.0, 1.0, 2.0, 0.5)
.constf byteconst(0.007874016, 0.0, 0.0, 0.0) ; 1/127: signed-byte tangent -> [-1,1]
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy
.alias  twos  myconst.zzzz
.alias  half  myconst.wwww
.alias  bytescale byteconst.xxxx

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1   ; same UV for the normal map on texture unit 1
.out outclr color
.out outview view
.out outnq normalquat

; Inputs
.alias inpos v0  ; position
.alias intex v1  ; texcoord
.alias innrm v2  ; object-space normal
.alias invclr v3 ; baked vertex color
.alias intng v4  ; object-space tangent, signed bytes (x127)
.alias inmat v5  ; fixed: material tint (_Color)

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * inpos
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outview = eye - position (eye is the origin in view space)
	mov outview, -r1

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; Texture coordinates: _MainTex_ST tiling (xy) and offset (zw), shared by both units.
	mov r9, uvTransform
	mov r10, intex
	mad r10.xy, r10.xy, r9.xy, r9.zw
	mov outtc0, r10
	mov outtc1, r10

	; Albedo tint: vertex color * material color (the TEV multiplies the texture in).
	mov r5, invclr
	mul r5, r5, inmat
	mov outclr, r5

	; N = normalize(normalMatrix * normal)   (inverse-transpose: correct under non-uniform scale)
	dp3 r14.x, normalMatrix[0], innrm
	dp3 r14.y, normalMatrix[1], innrm
	dp3 r14.z, normalMatrix[2], innrm
	dp3 r6.x, r14, r14
	rsq r6.x, r6.x
	mul r14.xyz, r14.xyz, r6.x

	; T = normalize(modelView3x3 * tangent)
	mul r11, bytescale, intng
	dp3 r12.x, modelView[0], r11
	dp3 r12.y, modelView[1], r11
	dp3 r12.z, modelView[2], r11
	dp3 r6.x, r12, r12
	rsq r6.x, r6.x
	mul r12.xyz, r12.xyz, r6.x

	; Cross N x T = B
	mul r13.xyz, r14.yzx, r12.zxy
	mad r13.xyz, -r12.yzx, r14.zxy, r13

	; Cross B x N = T (re-orthonormalizes T against N)
	mul r12.xyz, r13.yzx, r14.zxy
	mad r12.xyz, -r14.yzx, r13.zxy, r12

	; Readjust vectors for easier calculation:
	; r12 = (Tx, Ty, Tz, Bz)
	; r13 = (Tx, By, Nz, 1 )
	; r14 = (Nx, Ny, Nz, Bx)
	mov r12.w, r13.z
	mov r14.w, r13.x
	mov r13.x, r12.x
	mov r13.z, r14.z
	mov r13.w, ones

	; Perform case discrimination
	mov r11.z, zeros
	sge r10, zeros, r14.z
	mov r11.xyw, r13.zxzy
	add r10, r10, r10
	mad r11.y, r10, r11, -r11
	cmp r11.xy, le, ge, r11.zw

	ifc cmp.x
		ifc cmp.y
			; X case
			mov r13.yz, -r13
			mov r14.y, -r14
			dp4 r0.x, r13.w, r13
			add r0.yzw, r12.yyzw, r14.wwxy
		.else
			; Y case
			mov r13.xz, -r13
			mov r12.z, -r12
			dp4 r0.y, r13.w, r13
			add r0.xzw, r12.yywz, r14.wwyx
		.end
	.else
		ifc cmp.y
			; Z case
			mov r13.xy, -r13
			mov r14.w, -r14
			dp4 r0.z, r13.w, r13
			add r0.xyw, r12.zwwy, r14.xyyw
		.else
			; W case
			mov r12.z, -r12
			mov r14.yw, -r14
			dp4 r0.w, r13.w, r13
			add r0.xyz, r12.wzyy, r14.yxww
		.end
	.end

	; Renormalize quaternion and output
	dp4 r1.x, r0, r0
	rsq r1.x, r1.x
	mul outnq, r0, r1.x

	end
.end
