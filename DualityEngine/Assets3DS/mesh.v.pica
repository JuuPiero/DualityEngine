; DualityEngine forward mesh shader. VertexLit uses Gouraud Lambert lighting;
; the backend supplies white ambient/zero diffuse for backwards-compatible Unlit draws.
; Shape based on References/devkitpro-3ds-templates/graphics/gpu/{simple_tri,textured_cube}'s
; own proven vshader.v.pica sources.

; Uniforms
.fvec projection[4], modelView[4], lightVec, lightColor, ambientColor

; Constants
.constf myconst(0.0, 1.0, -1.0, -0.5)
.alias  zeros myconst.xxxx ; Vector full of zeros
.alias  ones  myconst.yyyy ; Vector full of ones

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs (defined as aliases for convenience)
.alias inpos v0 ; loaded, per-vertex (position)
.alias intex v1 ; loaded, per-vertex (texcoord)
.alias innrm v2 ; loaded, per-vertex object-space normal
.alias inclr v3 ; fixed material color

.proc main
	; Force the w component of inpos to be 1.0
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * inpos
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; Transform and normalize the normal. The first PICA VertexLit tier supports
	; uniform scale; desktop's GLSL path additionally uses an inverse-transpose normal matrix.
	mov r2.xyz, innrm
	mov r2.w, zeros
	dp4 r3.x, modelView[0], r2
	dp4 r3.y, modelView[1], r2
	dp4 r3.z, modelView[2], r2
	dp3 r4.x, r3, r3
	rsq r4.x, r4.x
	mul r3.xyz, r3, r4.x

	; ambient + lightColor * max(dot(normal, lightVector), 0)
	dp3 r4.x, lightVec, r3
	max r4.x, zeros, r4.x
	mul r4, lightColor, r4.xxxx
	add r4, ambientColor, r4

	; Modulate material color by the vertex-lighting result.
	mov outtc0, intex
	mul outclr, inclr, r4

	; We're finished
	end
.end
