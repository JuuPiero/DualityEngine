; DualityEngine unlit 3D mesh vertex shader (see IRenderer3D.h/Citro3DRenderer.cpp) --
; position * (projection * modelView) plus texcoord/color passthrough, no lighting.
; Shape based on References/devkitpro-3ds-templates/graphics/gpu/{simple_tri,textured_cube}'s
; own proven vshader.v.pica sources.

; Uniforms
.fvec projection[4], modelView[4]

; Constants
.constf myconst(0.0, 1.0, -1.0, -0.5)
.alias  zeros myconst.xxxx ; Vector full of zeros
.alias  ones  myconst.yyyy ; Vector full of ones

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs (defined as aliases for convenience)
.alias inpos v0 ; loaded, per-vertex (position)
.alias intex v1 ; loaded, per-vertex (texcoord)
.alias inclr v2 ; fixed, set once per DrawMesh call (flat Color -- see Citro3DRenderer::DrawMesh)

.proc main
	; Force the w component of inpos to be 1.0
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * inpos
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; outtc0 = intex, outclr = inclr
	mov outtc0, intex
	mov outclr, inclr

	; We're finished
	end
.end
