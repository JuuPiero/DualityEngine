; DualityEngine forward mesh shader for Unlit/* and Mobile/VertexLit materials.
; Mobile/VertexLit uses Gouraud Lambert lighting (ambient + main directional light); the backend
; supplies white ambient/zero diffuse for Unlit draws, which therefore cost nothing extra.
; Lit/* and Toon/* materials use mesh_lit.v.pica + PICA200 fragment lighting instead.
; Shape based on References/devkitpro-3ds-templates/graphics/gpu/{simple_tri,textured_cube}'s
; own proven vshader.v.pica sources.

; Uniforms
.fvec projection[4], modelView[4], lightVec, lightColor, ambientColor, uvTransform

; Constants
.constf myconst(0.0, 1.0, -1.0, -0.5)
.alias  zeros myconst.xxxx ; Vector full of zeros
.alias  ones  myconst.yyyy ; Vector full of ones

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs (defined as aliases for convenience)
.alias inpos v0 ; loaded, per-vertex (position)
.alias intex v1 ; loaded, per-vertex (texcoord)
.alias innrm v2 ; loaded, per-vertex object-space normal
.alias invclr v3 ; loaded baked vertex color (white when the source has none)
.alias inmat v4 ; fixed material color

.proc main
	; Force the w component of inpos to be 1.0
	mov r0.xyz, inpos
	mov r0.w,   ones

	; r1 = modelView * inpos
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; Transform and normalize the normal. The VertexLit tier supports uniform scale;
	; desktop's GLSL path additionally uses an inverse-transpose normal matrix.
	mov r2.xyz, innrm
	mov r2.w, zeros
	dp4 r3.x, modelView[0], r2
	dp4 r3.y, modelView[1], r2
	dp4 r3.z, modelView[2], r2
	dp3 r4.x, r3, r3
	rsq r4.x, r4.x
	mul r3.xyz, r3, r4.x

	; ambient + lightColor * max(dot(normal, lightVector), 0)
	dp3 r4.x, lightVec, r3
	max r4.x, zeros, r4.x
	mul r4, lightColor, r4.xxxx
	add r4, ambientColor, r4

	; Texture coordinates: _MainTex_ST tiling (xy) and offset (zw).
	mov r9, uvTransform
	mov r10, intex
	mad r10.xy, r10.xy, r9.xy, r9.zw
	mov outtc0, r10

	; Modulate material and imported baked vertex color by the lighting result.
	; PICA cannot use two v-registers as operands of one arithmetic instruction.
	; Stage vertex color in a temporary first, then apply fixed material color.
	mov r5, invclr
	mul r5, r5, inmat
	mul outclr, r5, r4

	; We're finished
	end
.end
